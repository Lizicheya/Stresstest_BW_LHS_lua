# NOTE: 路径改写为 Windows 风格(E:/...),便于 gcc / Lua / LuaRocks 在 Windows 下直接使用。

prefix=E:/LuaYaCe/luarocks
sysconfdir=E:/LuaYaCe/luarocks/etc
rocks_tree=E:/LuaYaCe/luarocks
LUA_VERSION=5.3
LUA=E:/LuaYaCe/luarocks/bin/lua.exe
LUA_DIR=E:/LuaYaCe/luarocks
LUA_BINDIR=E:/LuaYaCe/luarocks/bin
LUA_INCDIR=E:/LuaYaCe/luarocks/include
LUA_LIBDIR=E:/LuaYaCe/luarocks/lib
FORCE_CONFIG=yes
