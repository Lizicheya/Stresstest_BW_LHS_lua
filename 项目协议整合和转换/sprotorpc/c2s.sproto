        news 0: *ComOfficialOptType(id)
        changes 1: *ComOfficialOptType(id)
        removes 2: *integer
    }

    .ComOfficialWaitQueueItem {
        uid 0: integer               # 玩家uid
        turnOfficialsTime 1: integer # 排队排到可以上岗的时间戳

        # 以下为给客户端的显示数据
