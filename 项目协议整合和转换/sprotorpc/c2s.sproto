        position 8: integer #成员官职
        joinTime 9: integer #加入时间
        power 10: integer #战力
        kill 11: integer #击杀
        isApplyForLeader 12: boolean #是否竞选盟主
        x 13: integer #场景坐标x
        y 14: integer #场景坐标y
        massTime 15: integer #群发消息的时间戳
        crossServerId 16: integer #跨服服务器id
        permission 17: uint32 # 成员权限
        castleLv 18: uint32 # 主堡等级
