        agendaId 0 : string # 日程 id
        actId 1 : integer # 活动 id
        triggerTimestamp 2 : integer # 活动触发时间戳
        duration 3 : integer # 活动持续时间
        weight 4 : integer # 活动权重
        uiParam 5 : integer # 活动 ui 参数 id
        showTime 6 : integer # 活动展示时间
