.package {
    type 0 : integer            # 协议类型
    session 1: integer          # client server 各维护一套自增的id
    ud 2 : integer              # response:用于错误码;推送:用户包确认
}

.ComMarkMessage {
        id 0: integer #留言板id
        time 1: integer #时间戳
        content 2: string #内容
        uid 3: integer #留言玩家
        nickName 4: string #玩家昵称
        headId 5: integer #头像
        headFrameId 6: integer #头像框
        customHead 7: string #自定义头像
    }

.ComGuideData {
        guideId 0: integer          # 引导id
        state 1: integer            # 状态
        
    }

    .ComSyncGuideData {
        news 0 : *ComGuideData(guideId)                           # 新增
        changes 1 : *ComGuideData(guideId)                        # 更新
        removes 2 : *integer                                      # 移除
    }

.StrongesLordStageData {
        selectScoreId 0 : integer # 选择的积分 id, 可选的才有
        score 1 : integer # 积分
        rank 2 : integer # 排名
    }

    .StrongesLordStageDataHash {
        stage 0 : integer
        data 1 : StrongesLordStageData
    }

    .StrongesLordData {
        curStage 0 : integer # 当前阶段
        scoreTotal 1 : integer # 总积分
        rankTotal 2 : integer # 总排名
        stageData 3 : *StrongesLordStageDataHash() # 阶段数据
        scoreClaimData 4 : ComActivityScoreClaimData # 积分数据
    }

    .StrongesLordParam {
        configGroupId 0 : integer # 活动配置组 Id
    }

    .StrongesLordInfo {
        actId 0 : integer # 活动 id
        round 1 : integer # 轮次
        state 2 : integer # 状态
        param 3 : StrongesLordParam # 参数
        data 4 : StrongesLordData
    }

.ComClientDataIntInt {
        key 0: integer           # ClientDataType枚举，客户端自己维护
        value 1: *ComIntInt()    # 客户端自己存储的数据结构
    }
    .ComClientData {
        structIntInt 0: *ComClientDataIntInt()
    }

    .ComSyncClientDataIntInt {
        news 0 : *ComClientDataIntInt()                           # 新增
        changes 1 : *ComClientDataIntInt()                        # 更新
        removes 2 : *integer                                      # 移除
    }

    .ComSyncClientData {
        structIntInt 0: ComSyncClientDataIntInt
    }

.ComActivityTotalSignIn {
        round 0: integer                            # 轮次
        actId 1: integer                            # 活动id
        configId 2: integer                         # 活动配置参数(本组件指向ActivityNewbieGrowthReward-activityId字段)
        scoreClaimData 4: ComActivityScoreClaimData # 积分数据
    }

    .ComSyncActivityTotalSignIn {
        news 0: *ComActivityTotalSignIn(actId)
        changes 1: *ComActivityTotalSignIn(actId)
        removes 2: *integer
    }

.PayGameOrderParam {
        selectContent 0 : *uint32 # 选择内容
    }

    .PayGoodsData {
        startTime 1 : integer # 开始时间
        duration 2 : integer # 持续时间
        nextRefreshTime 3 : integer # 下次刷新时间
        purchasedCount 4 : integer # 已购买次数
        isPopup 5 : boolean # 是否弹窗
        enable 6 : boolean # 是否可购买

        # 宝石模块类型数据
        isDouble 7 : boolean # 是否双倍
        # 多选一礼包类型数据
        selectGoodsId 8 : integer # 选择的商品 id
    }

    .PayGoods {
        goodsId 0 : integer # 礼包 id
        goodsData 1 : PayGoodsData # 礼包数据
    }

.ComRankPlayer {
        uid 0: integer                                  #玩家id
        nickName 1: string                              #玩家昵称
        headId 2: integer                               #头像
        headFrameId 3: integer                          #头像框
        customHead 4: string                            #自定义头像
        rank 5: integer                                 #排名
        score 6: integer                                #排行值
        abbName 7: string                               #联盟简称
        serverId 8: integer                             #服务器id
        gloryLv 9: integer                              #赛季荣耀等级
    }

    .ComRankAlliance {
        id 0: integer                                   #联盟id
        fullName 1: string                              #联盟全称
        abbName 2: string                               #联盟简称
        serverId 3: integer                             #服务器id
        flagId 4: integer                               #旗帜id
        patternId 5: integer                            #图案id
        colorId 6: integer                              #颜色id
        rank 7: integer                                 #排名
        value 8: integer                                #排行值
    }

    .ComRankKingdom {
        id 0: integer                                   #服务器id
        rank 1: integer                                 #排名
        value 2: integer                                #排行值
    }

    .ComRankList {
        playerList 0: *ComRankPlayer
        allianceList 1: *ComRankAlliance
        kingdomList 2: *ComRankKingdom
    }

    .ComRankNScore {
        rankCfgId 0: integer
        rank 1: integer
        score 2: integer
    }

    .ComRankParams {                                # 排行榜额外参数
        actId 0: uint32                            # 活动id 
    }

    .ComRankCfgIdNParams {
        rankCfgId 0: uint32
        params 1: ComRankParams
    }

.pushEventMap {
        eventGroupId 0 : integer # 事件 id
        eventValue 1 : integer # 事件开关值：0 关闭，其他 开启
    }

.CompTrialTroop {
        type 1: uint32
        army 19: *ComArmyIdAndNum()
        heros 17: *uint32
        targetX 15: uint32
        targetY 16: uint32
    }

.ComBuildingData {
        durability 0: integer #当前耐久度
        buildSpeed 1: double #建造速度 N/h
        speedTime 2: integer  #当前速度的时间戳
        endTime 3: integer    #建造结束时间戳
        brokenTime 4: integer #损毁截止时间
        destroySpeed 5: double #敌方拆除速度
        destroyTime 6: integer #当前拆除速度的时间戳
        destroyEndTime 7: integer #敌方拆除完成时间戳
        terrArea 8: integer #领地值
        buildStage 9: integer #建造or扩建

    }

    .ComAltar {
        level 0: integer #等级
        exp 1: integer   #经验
        stage 2: integer #阶段 1准备 2召唤 3试炼
        stageEndTime 3: integer #阶段时间戳
        monsterId 4: integer #祭坛boss
        summonTime 5: integer #召唤时间
        alliancePoint 6: ComPoint # 建造时联盟集合点坐标
    }

    .ComHonorMine {
        lifeTime  1: integer                                #到期回收时间戳
        remainResource 2: integer                           #剩余资源
        collectSpeed  3: double                             #当前采集速度
        collectSpeedTime  4: integer                        #当前采集速度开始时间戳
        collectTroopIds 5: *ComIntInt()                     #采集部队 [uid]=troopId 
    }

    .ComAllianceFish {
    }

    .ComAllianceBuild {
        id 0: integer #建筑id,联盟内唯一
        bid 1: integer #建筑配置id
        x 2: integer #x坐标 
        y 3: integer #y坐标
        status 4: integer #建筑状态 AllianceBuildStatusType
        isAct 5: boolean #是否有效
        sn 6: integer #sn值,判断地块归属,sn值小的拥有地块所有权
        isGarrison 7: boolean #是否驻防
        isDismantle 8: boolean #是否拆除中 
        dismantleTime 9: integer #开始拆除时间戳
        buildingData 10: ComBuildingData
        allianceAltar 11: ComAltar #祭坛
        allianceBlockMine 12: ComHonorMine #联盟积木矿
        allianceFish 13: ComAllianceFish #联盟钓鱼宴会建筑
    }

.ComActFishShop {          # 活动信息
        actId 0: integer       # 活动id
        round 1: integer       # 轮次
        state 2: integer
        isOver 3: boolean
    }
    
    .ComSyncActFishShop {
        news 0: *ComActFishShop(actId)
        changes 1: *ComActFishShop(actId)
        removes 2: *integer
    }

#聚落战争聚落信息
    .ComCampongWarBuildInfoEx {
        id 0: integer                   # 聚落ID
        status  1: integer              # 状态 MapBuildStatusType
        endTime  2: integer             # 当前状态结束时间
        round 3: integer                # 最终开启时间段
        rounds 4: *integer              # 报名开始时间的索引
        autoRegist 5: boolean           # 是否自动报名
        aid 6: integer                  # 占领/归属联盟ID
        aliInfo 7: ComAllianceBrief     # 占领/归属联盟信息 可nil
        npcId 8: integer                # npc ID
        time 9: integer                 # 占领结束时间
        objId 10: integer               # 对象ID
    }

    .ComCampongWarBuildDivide {
        id 0: integer                   # 聚落ID
        killDivideId 1: integer        # id(分配ID)
        occupyDivideId 2: integer      # id(分配ID)
    }

    #聚落战争活动信息
    .ComCampongWarActivityInfo {
        seasonId 0: integer      # 第几赛季
        round 1: integer         # 第几轮
        startTime 3: integer     # 开始时间
        status 4: integer        # 活动状态 campongWarStatus
        durations 5: *integer    # 状态时间
        groupId 6: integer       # 赛季奖励组id
        buildDivides 7 : *ComCampongWarBuildDivide(id) #建筑随机分配id
    }

    #聚落战争分配奖励信息
    .ComCampongWarDivideRewardInfo {
        divideId 0: integer      # id(分配ID)
        divideNum 1: integer     # 已经分配了数量
        players 2: *integer      # 已经领取了玩家ID
    }

    #聚落战争联盟积分信息
    .ComCampongWarAllianceInfo {
        id 0: integer                                   #联盟id
        fullName 1: string                              #联盟全称
        abbName 2: string                               #联盟简称
        flagId 4: integer                               #旗帜id
        patternId 5: integer                            #图案id
        colorId 6: integer                              #颜色id
        leaderId 7: integer                             #盟主ID
        leaderName 8: string                            #盟主名字
        point  9: integer                               #积分
    }

    #聚落战争历史数据
    .ComCampongWarOccupyHistoryData {
        idx 0: integer                                  #第几任
        aid 1: integer                                  #联盟id
        fullName 2: string                              #联盟全称
        abbName 3: string                               #联盟简称
        flagId 4: integer                               #旗帜id
        patternId 5: integer                            #图案id
        colorId 6: integer                              #颜色id
        leaderId 7: integer                             #盟主ID
        leaderName 8: string                            #盟主名字
        headId 9: integer                               #头像id
        headFrameId 10: integer                         #头像框id
        createTime 11: integer                          #创建时间
    }

    #聚落战争数据
    .ComCampongWarData {
        actInfo 0: ComCampongWarActivityInfo
        divideList 1: *ComCampongWarDivideRewardInfo(divideId)     #无players
    }

    .ComCampongWarPlayer {
        uid 0: integer                                  #玩家id
        nickName 1: string                              #玩家昵称
        headId 2: integer                               #头像
        headFrameId 3: integer                          #头像框
        customHead 4: string                            #自定义头像
        power 5: integer                                #战力
    }

    .ComCampongWarRegistInfo {
        campongId 0: integer
        rounds 1: *integer        # 报名开始时间的索引
        autoRegist 2: boolean     # 是否自动报名
    }

.ContinuousRechargeData {
        actDay 0 : integer # 当前激活第几天
        totalScoreDayList 1 : *integer # -- key=天，value=充值总积分
        todayAddScoreTime 2 : integer # 每天第一次获得积分的时间戳，重置积分时判断依据
        boxRewardGetTime 3 : integer # 宝箱奖励领取时间
        boxRewardCount 4 : integer # 宝箱领取次数
        rechargePlan 5 : integer # 充值宝箱奖励进度
        isGotPlanReward 6 : boolean # 宝箱进度奖励是否已领取
    }

    .ContinuousRechargeParam {
        groupId 0 : integer # 活动配置组 Id
    }

    .ContinuousRechargeInfo {
        actId 0 : integer # 活动 id
        round 1 : integer # 轮次
        state 2 : integer # 状态
        param 3 : ContinuousRechargeParam # 参数
        data 4 : ContinuousRechargeData
    }

.ComShopSlot {
        shopItemId 1: integer               # 物品ID
        buyCount 2: integer                 # 购买数量
        limitCount 3: integer               # 限制数量
        disaccountPrice 4: *ComRes          # 折扣价格
        originalPrice 5: *ComRes            # 原价
        disaccount 6: integer               # 折扣
        flag 7: integer                     # 标志
        items 8 : *ComRes                   # 获得的物品
        slotId 9: integer                   # 槽位ID
        conditions 10: *ComCondition        # 条件数据
        buyMaxCount 11: integer             # 最大购买限制
        sheet 12: integer                   # 子页签
        showCount 13: integer               # 是否显示库存
        itemSort 14: integer                # 排序因子
        freeTimes 15: integer               # 剩余免费购买次数
    }

    .ComShop {
        id 1: integer                           # 商店id
        manualRefreshCount 2: integer           # 商店手动刷新次数
        slots 3: *ComShopSlot(slotId)           # 商城槽位信息
        nextAutoRefreshTime 4:integer           # 下一次自动刷新时间
        attrManualRefreshCount 5:integer        # 属性手动刷新次数
    }

    .ComActivityShopStat { # 活动商店统计信息
        statCfgId 0: integer
        count 1: integer
    }

    .ComActivityShop {
        activityId 0: integer                   # 活动
        shopId 1: integer                       # 商店id
        items 2: *ComIntInt()                   # 购买信息
        nextAutoRefreshTime 4:integer           # 下一次自动刷新时间
        nextDailyFreeItemsTime 5: *ComIntInt()  # 下次商品可以免费领的时间戳（秒）
        gainList 6: *ComIntInt()                # 已经领取过的进度奖励列表
        stat 7: *ComActivityShopStat(statCfgId) # 统计进度
    }
    
    .ComShopRefresh {
        shopId 0: integer                       # 商店Id
        freeCountAttr 1: integer                # 商店免费刷新次数属性id
        freeManualRefreshCount 2: integer       # 商店免费刷新次数
        version 3: integer                      # 版本号
    }
    
    .ComShopFreeSlot {
        shopId 0: integer                       # 商店Id
        version 1: integer                      # 版本号
        freeSlotIds 2: *integer                 # 免费槽
    }

.ComInnerCityRegionTask { # 内城区域任务
        taskId 1: integer # 任务id
        status 2: integer # 任务状态 1:进行中 2:完成
        count 3: integer # 任务当前进度数量
    }

    .ComSyncDataInnerCityRegionTask { # 内城区域任务同步
        news 1: *ComInnerCityRegionTask(taskId)
        changes 2: *ComInnerCityRegionTask(taskId)
        removes 3: *integer
    }
    
    .ComInnerCityRegion { # 内城区域
        regionId 1: uint32 # 当前区域id
        tasks 2: *ComInnerCityRegionTask(taskId) # 任务列表
        isFinish 3: boolean # 是否全部完成
    }
    
    .ComSyncDataInnerCityRegion { # 内城区域同步
        regionId 1: uint32 # 当前区域id
        tasks 2: ComSyncDataInnerCityRegionTask # 任务同步
        isFinish 3: boolean # 是否全部完成
    }

.ComUnlockFlags {
        key 0: integer                                  # 索引
        value 1: *integer                               # 解锁标记,8字节整数,每个整数64位,表示64个点
    }
    .ComCityAreaUnlock {
        areaCfgId 0: integer                            # id(innerCityArea表id)
        status 1: integer                               # 状态(CityAreaStatusType)
        statusTs 2: integer                             # 状态开始时间
        #arrRectUnlockFlags 3: *ComUnlockFlags()        # 矩形解锁标记
        event 3: integer                                # 事件 0=事件已完成  1=事件未完成
    }

.ComActivityAncientSearch {
        actId 1: integer               #活动id
        param 2: AncientSearchParam    #活动参数
        data  3: AncientSearchData     #活动数据
    }

    .ComSyncActivityAncientSearch {
        news 0: *ComActivityAncientSearch(actId)
        changes 1: *ComActivityAncientSearch(actId)
        removes 2: *integer
    }

    .AncientSearchParam {
        taskGroupId 1: integer #任务组id
        rewardGroupId 2: integer #奖励组id
    }

    .AncientSearchData {
        stage 1: integer        #阶段
        complete 2: boolean     #是否结束
        item 3: *ComIntInt()    #活动物品
        rewardList 4: *integer  #已领奖任务阶段

    }

    .ComSyncAncientSearchItem {
        actId 0: integer
        news 1: *ComIntInt()                           # 新增
        changes 2: *ComIntInt()                        # 修改
        removes 3: *integer                            # 删除
    }

.ComActivitySkinCollectData {
        # taskIndexList 0: *ComIntInt() # 经历的任务阶段下标
        curIndex 1: integer # 客户端当前阶段
    }

    .ComActivitySkinCollectParam {
        configId 0: integer # 活动配置Id
    }

    .ComActivitySkinCollectInfo {
        actId 0: integer # 活动 id
        round 1: integer # 轮次
        state 2: integer # 状态
        param 3: ComActivitySkinCollectParam # 参数
        data 4: ComActivitySkinCollectData
    }

.ComActivityAllianceDuelParam {
        relationId 1: integer
    }

    .ComActivityAllianceDuel {
        actId 1: integer # 活动id 保留字段无用
        state 2: integer # 活动阶段 1:预告 2开始 3结算 4结束
        isOver 3: boolean # 活动是否结束
        startTimestamp 4: integer # 活动开始时间戳
        stagesDuration 5: *integer # 各阶段持续时间
        stageList 6: *ComIntBool() # 今日已领取积分档位奖励 [档位id] = true
        score 7: integer # 玩家今日积分
        targetAid 8: integer # 匹配到的联盟
        param 9: ComActivityAllianceDuelParam # 活动参数
        nextTargetAid 10: integer # 下一轮匹配到的联盟
    }

    .ComDuelDailyMvp {
        key 1: integer
        value 2: ComDuelPlayer
    }

    .ComDuelPlayer {
        uid 1: integer         # 玩家uid
        nickName 2: string     # 昵称
        headId 3: integer      # 头像
        headFrameId 4: integer # 头像框
        customHead 5: string   # 自定义头像
        serverId 6: integer    # 玩家所在王国id
    }

    .ComDuelAllianceData {
        aid 1: integer          # 联盟id
        fullName 2: string      # 联盟全称
        abbName 3: string       # 联盟简称
        flagId 4: integer       # 标志样式
        colorId 5: integer      # 标志颜色
        patternId 6: integer    # 标识图案
        serverId 7: integer     # 联盟所在王国id
        dailyScore 8: integer   # 联盟当日积分
        duelScore 9: integer    # 联盟对决总积分
        mvpUser 10: ComDuelPlayer # 联盟mvp玩家
        power 11: integer       # 联盟战力
        isDisband 12: boolean   # 联盟是否已解散
        scoreList 13: *ComIntInt() # 每日积分 [dayId] = score
    }

.RegularGvgWarParam {
        seasonId 1: integer
    }

    .SeasonGvgWarVoteInfo {
        uid 1: integer
        headId 2: integer
        headFrameId 3: integer
        customHead 4: string #自定义头像
        nickName 5: string #昵称
        power 6: integer #战力
    }

    .ComRegularGvgWarActInfo {
        actId 1: integer # 活动id
        param 2: RegularGvgWarParam # 活动参数
        isOver 3: boolean # 活动是否结束
        warRound 4: integer # 第几轮
        stage 5: integer # 阶段
        stageOverTs 6: integer # 当前阶段结束时间戳

    }

.ComActivityAllianceHelp {
        state 0: integer # 活动状态 0:未开始 1:进行中 2:已结束
        startTimestamp 1: integer # 活动开始时间戳
        endTimestamp 2: integer # 活动结束时间戳
        over 3: boolean # 活动是否结束
        stageList 4: *ComIntBool() # 已领取奖励列表
        totalTime 5: integer # 总帮助时长（秒）
    }

.ComActChampionshipParam {
        configId 1: integer
    }
    
    .ComChampionshipDuelData {
        actId 0: integer
        isSignUp 1: boolean                         # 是否报过名
        curStage 2: integer                         # 当前赛事阶段
        session 3: integer                          # 当前场次
        formations 4: *ComArenaTeam()               # 上阵阵容
        items 5: *ComIntInt()                       # 狂欢道具列表
        exchangeList 6: *ComIntInt()                # 已兑换列表
        boxPoints 7: integer                        # 狂欢进度值
        pointsList 8: *ComIntBool()                 # 已领取的狂欢进度宝箱
        param 9: ComActChampionshipParam            # 活动参数
        battleBoxList 10: *integer                  # 已经领取的胜场宝箱列表 stage * 100 + id
        winCount 11: integer                        # 海选赛胜利场次
        betCount 12: integer                        # 当前场次已下注次数(淘汰赛或八强赛阶段)
    }

    .ComChampionshipRankPlayer {
        uid 0: integer                                  #玩家id
        nickName 1: string                              #玩家昵称
        headId 2: integer                               #头像
        headFrameId 3: integer                          #头像框
        customHead 4: string                            #自定义头像
        power 5: integer                                #战力
        rank 6: integer                                 #排名
        score 7: integer                                #排行值
        abbName 8: string                               #联盟简称
        serverId 9: integer                             #服务器id
        winCount 10: integer                            #胜利场次
        failCount 11: integer                           #失败场次 
    }

    .ComChampionshipBattlePlayer {
        uid 0: integer                                  #玩家id
        nickName 1: string                              #玩家昵称
        headId 2: integer                               #头像
        headFrameId 3: integer                          #头像框
        customHead 4: string                            #自定义头像
        abbName 5: string                               #联盟简称
        serverId 6: integer                             #服务器id
        power 7: integer                                #战力
    }

    .ComChampionshipBattleInfo {
        groupId 1: integer                           # 小组id
        battleId 2: integer                          # 编号id
        players 3: *ComChampionshipBattlePlayer      # 对战双方
        winner 4: integer                            # 获胜者
        scoreArray 5: *integer                       # 比分
    }

    .ComChampionshipRecordInfo {
        stage 0: integer                             # 赛事阶段
        groupId 1: integer                           # 小组id
        battleId 2: integer                          # 编号id
        players 3: *ComChampionshipBattlePlayer      # 对战双方
        winner 4: integer                            # 获胜者
        scoreArray 5: *integer                       # 比分
        session 6: integer                           # 场次
    }

    .ComChampionshipContestInfo {
        stage 0: integer                             # 赛事阶段
        groupId 1: integer                           # 小组id
        battleId 2: integer                          # 编号id
        players 3: *ComChampionshipBattlePlayer      # 对战双方
        winner 4: integer                            # 获胜者
        scoreArray 5: *integer                       # 比分
        betNumArray 6: *integer                      # 双方下注人数
        odds 7: integer                              # 赔率
