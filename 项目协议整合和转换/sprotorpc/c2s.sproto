# === activityDaggerThrowingProto.lua ===
selectSpecialReward 8751 {      # 选择飞刀活动大奖
        request {
            actId 0: uint32         # 活动id
            rewardId 1: uint32      # 大奖配置id
        }
        response {
        }
    }

    daggerThrowing 8752 {            # 飞刀抽奖一次
        request {
            actId 0: uint32          # 活动id
        }
        response {
            specialReward 0: boolean # 本次抽奖抽出的是大奖奖励
            dropRes 1: *ComRes       # 获得的奖励
        }
    }

    daggerThrowing2Win 8753 {        # 飞刀连续抽直到抽出大奖
        request {
            actId 0: uint32          # 活动id
            maxTimes 1: uint32       # 最多抽奖次数
        }
        response {
            list 0: *ComDaggerThrowing2WinResult
        }
    }

    receiveActDaggerThrowingReward 8754 { # 领取飞刀活动存起来的奖励
        request {
            actId 0: uint32          # 活动id
        }
        response {
            rewardList 0: *ComRes
        }
    }

    gainActDaggerThrowingLevelReward 8755 { # 领取飞刀活动通过层数奖励
        request {
            actId 0: uint32          # 活动id
            cfgId 1: uint32          # 奖励的配置id
        }
        response {
            rewardList 0: *ComRes
        }
    }

# === activityDungeonRewardProto.lua ===
reqClaimDungeonReward 5401 { # 领取副本额外奖励
    request {
        actId 0: uint32 # 活动id
        index 1: uint32 # 配置表中的下标
    }
    response {
        ress 0: *ComRes # 获得的资源
    }
}

# === activityFateWheelCompProto.lua ===
fateWheelDrawOne 5001 {                    #抽奖一次
    request {
        id 0: uint32                       #ID
    }
    response {
        rewards 0: *ComFateWheelReward
        ress 1: *ComRes
    }
}
 
fateWheelDrawMutil 5002 {                  #抽奖多次次数必须大于等于10
    request {
        id 0: uint32                       #ID
        num 3: uint32                      #数量
    }
    response {
        rewards 0: *ComFateWheelReward
        ress 1: *ComRes                     # 10抽以上只显示奖励，不做表现动画
    }
}
 
getFateWheelBoxReward 5003 {               #获取幸运之轮宝箱奖励
    request {
        id 0: uint32                       #ID
        subId 1: uint32                    #子ID
    }
    response {
        ress 0: *ComRes
    }
}
 
reqFateWhellExchangeAndUse 5005 {               # 命运之轮兑换
    request {
        id 0: uint32                      #ID
        count 1: uint32                   #兑换次数+
    }
    response {
        rewards 1: *ComFateWheelReward
        ress 2: *ComRes                     # 10抽以上只显示奖励，不做表现动画
    }
}

reqFateWheelChangeGroup 5006 {   # 更换奖池组
    request {
        id 1: uint32
        groupId 2: uint32
    }
    response {

    }
}

# === activityFishAllianceRewardProto.lua ===
reqActFishAllianceReward 8951 {     # 请求活动钓鱼联盟宴会排行榜奖励
        request {
            actId 0: uint32             # 活动id
        }
        response {
        }
    }
    
    reqOpenActFishAlliance 8952 {       # （预约）开启宴会
        request {
            actId 0: uint32             # 活动id
            openTime 1: uint32          # 开启时间戳（秒），传 0 就是马上开启
        }
        response {
        }
    }

    reqGiftTableLog 8953 {              # 请求加餐记录
        request {
            actId 0: uint32             # 活动id
        }
        response {
            list 0: *ComActFishAllianceRewardAllianceGiftTableLog(id)
        }
    }

    reqGainTableGiftLog 8954 {          # 请求餐桌就餐记录
        request {
            actId 0: uint32             # 活动id
            buildId 1: integer          # 餐桌id，ComSceneAllianceFishTable 里的 id
        }
        response {
            list 0: *ComActFishAllianceRewardAllianceTableGiftLog(uid)
            fromUid 1: integer          # 玩家uid，如果是玩家购买礼包刷的才有
            createTime 2: integer       # 创建时间戳（秒）

            nickName 10: string       # 玩家昵称
            headId 11: integer        # 头像
            headFrameId 12: integer   # 头像框
            customHead 13: string     # 自定义头像
        }
    }

    reqUserGainGiftLog 8955 {          # 请求玩家就餐记录
        request {
            actId 0: uint32            # 活动id
        }
        response {
            list 0: *ComActFishAllianceRewardAllianceUserGiftLog
        }
    }

# === activityFishProto.lua ===
reqFishing 8891 {                 # 请求钓鱼
        request {
            actId 0: uint32           # 活动id
            pondType 1: uint32        # 钓鱼类型 1=普通钓饵 2=特质钓饵
            searchLight 2: boolean    # 使用探照灯
            swimBladder 3: boolean    # 使用感应鱼鳔
            fishHook 4: boolean       # 使用特质鱼钩
            fishDetector 5: boolean   # 使用水下探测器
            fishCfgId 6: uint32       # 使用水下探测器选择的鱼
        }
        response {
            fishCache 0: ComActFishCache
        }
    }

    fishingResult 8892 {                # 钓鱼结果
        request {
            actId 0: uint32             # 活动id
            fish 1: *ComUint32Uint32()  # 钓到的鱼 fishCfgId => num
            mulit 2: uint32             # 额外多倍奖励
            achieveDepth 3: uint32      # 达到的深度
        }
        response {
        }
    }
    
    fishGearUpLv 8893 {                 # 渔具升级
        request {
            actId 0: uint32             # 活动id
            fishGearType 1: uint32      # 渔具类型
        }
        response {
        }
    }

    retFishTaskReward 8894 {            # 领取钓鱼任务奖励
        request {
            actId 0: uint32             # 活动 id
            taskId 1: uint32            # 任务 id
        }
        response {
            ress 0: *ComRes
        }
    }

