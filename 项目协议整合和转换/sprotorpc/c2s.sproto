        request {
            actId 0 : uint32 # 活动 id
            stage 1 : uint32 # 阶段
            team 2 : *ComArenaTeamDetail() # 队伍数据
        }
        response {}
    }

    peakArenaGuess 7504 { # 竞猜
        request {
            actId 0 : uint32 # 活动 id
            stage 1 : uint32 # 阶段
            battleId 2 : uint32 # 战斗 id
            selectUid 3 : uint32 # 选择的玩家 id
        }
        response {}
    }

    peakArenaClaimGuessReward 7505 { # 领取竞猜奖励
        request {
