        labelType 1: uint32             # 页签类型
        id 2 : uint32                   # id
        rounds 3: *uint32                # 战斗轮次 【1,battleRoundCount] 一次最多请求5个轮次
    }
    response {
        uid 0: uint32                   # uid为nil时 表示查自己的邮件，不为nil且>0时，表示查指定玩家的邮件
        labelType 1: uint32             # 页签类型
        id 2 : uint32                   # id
