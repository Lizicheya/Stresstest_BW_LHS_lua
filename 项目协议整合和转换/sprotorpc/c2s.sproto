        items2use 5: *ComUint32Uint32()                                   # 使用的道具(道具id->使用数量)
        optionalItems2use 6: *ComOptionalItem2use                   # 自选道具
    }
    response {
        id2num 0: *ComIntInt()                                      # 立即训练得到到的训练士兵配置id->数量
