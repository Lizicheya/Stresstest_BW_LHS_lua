        value 1: ComArenaFormation                      # 队伍数据
    }

    .ComArenaTeam {
        key 0: uint32                # 队伍编号
        value 1: *ComUint32Uint32()  # 队伍数据 pos=>heroCfgId
    }

    .ComAllianceMemberInfo {
