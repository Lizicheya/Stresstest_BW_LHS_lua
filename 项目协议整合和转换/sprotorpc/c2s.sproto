        response {
            ress 1: *ComRes             # 伤害达标获得的资源
            hisRess 2: *ComRes          # 历史伤害获得的资源
        }
    }

# === translateProto.lua ===
translate 7431 {
    request {
        text 0 : string # 原文
    }
    response {
        channel 0 : string # 渠道
        sl 1 : string # 源语言
        text 2 : string # 译文
    }
}

# 固定请求免费的翻译
translateFree 7432 {
    request {
        text 0 : string # 原文
    }
    response {
        channel 0 : string # 渠道
        sl 1 : string # 源语言
        text 2 : string # 译文
    }
}

# === trialProto.lua ===
createTrialRoom 901 { # 创建试炼房间
    request {
        trialCfgId 0: uint32           # 试炼配置表id
        troopData 1: CompTrialTroop     # 试炼部队
    }
    response {
    }
}

challengeTrial 902 { # 挑战副本
    request {
        trialCfgId 0: uint32           # 试炼配置表id
    }
    response {
    }
}

# === vipProto.lua ===
reqVipDayGift 4601 { # 领取vip每日礼物
    request {
       
    }
    response {
        dayGiftTS 0: integer    # 每日礼物领取时间更新
        dropRes 1: *ComRes      # 本次奖励
    }
}

reqVipDayExp 4603 { # 领取vip每日经验
    request {
    }
    response {
        dayVipExpTS 0: integer  # 每日经验领取时间更新
        exp 1: uint32           # 本次获得的 exp
    }
}

# === xGameplayProto.lua ===
xGameplayBattleResult 8561 {                          # 关卡战斗结果
    request {
        isWin 0: boolean                              # 是否胜利
        levelCfgId 1: uint32                          # 关卡id
        killList 2: *ComUint32Uint32()                # 击杀列表
    }
    response {
        ress 0: *ComRes                               # 奖励
    }
}

# === genClientQueryRspSproto.lua ===

# === loginproto.lua ===
#a、默认登录（直接打开游戏）不传uid,createNewRole
#b、切换账号（游戏内通过设置->角色界面，选择已经存在的角色）传uid,不传createNewRole
#c、创建账号（游戏内通过设置->角色界面，选择服务器后选择创建角色）传createNewRole=true
reqlogin 1 { #请求登陆
    request {
        account 0: string
        password 1: string
        sdkToken 2: string
        uid 3: uint32
        createNewRole 4: boolean
        serverId 5: uint32
        clientInfo 6: ClientInfo
    }
    response {
        sucess 0: boolean
        gameToken 1: string
        gatewayHost 2: string
        gatewayPort 3: uint32
        uid 4: uint32
        serverVersion 5: string
        configVersion 6: string
        isNew 7: boolean
        timeZone 8: integer # -12~12基于utc
    }
}

reqAuth 2 { #网关验证
    request {
        uid 0: uint32
        gameToken 1: string
        isReconnect 2: boolean
        sessionResponse 3 : uint32 # 服务器回包确认:回包对应的请求包的session
        sessionSync 4 : uint32 # 服务器推送包确认:服务器推送包的session
    }
    response {
        node 0: string # 节点名 
        agent 1: uint32 # agent 地址
    }
}
