        heros 13: ComSyncRogueHero               # 临时英雄
        firstRevive 14: boolean                  # 是否首次复活
        gear2Point 15: ComSyncGear2Point         # 每一组技能消耗技能点数
        nextTimestamp 16: integer                # 下次副本开启时间戳
        eventMap 21: ComSyncRogueRoom2EventId
    }

    .ComRogueSlot {
        slotId 1: integer               # 槽位ID
        itemId 2: integer               # 物品ID
        buyCount 3: integer             # 购买数量
    }

    .ComRogueEvent {
        eventId 0: integer                    # 事件id
        eventType 1: integer                  # 事件类型
        isComplete 2: boolean                 # 前置事件是否完成
        army 3: *ComArmyIdAndNum()            # 敌方兵力信息 战斗事件
        armyCapacity 4: *ComArmyIdAndNum()    # 敌方兵力容量
        buffList 5: *integer                  # 可供选择的buff列表
        slots 6: *ComRogueSlot(slotId)        # 商店数据 商店事件
        isOver 7: boolean                     # 当前房间是否结束
        heros 8: *integer                     # 敌方上阵英雄
        refreshBuffTimes 9: integer           # 当前付费刷新buff列表次数
        buffGroupId 10: integer               # buff组id
    }
    
    .ComSyncRogueBuff {
        news 1: *ComRogueBuff(id)                           # 新增buff列表
        changes 2: *ComRogueBuff(id)                        # 更新buff列表
        removes 3: *integer                                 # 删除buff
    }
    
    .ComSyncRogueSkill {
        news 1: *ComRogueSkill(groupId)                     # 新增技能列表
        changes 2: *ComRogueSkill(groupId)                  # 更新技能列表
        removes 3: *integer                                 # 删除技能
    }
    
    .ComRogueTroopHero { #上阵英雄
        heroId 0: integer #英雄ID 临时获得的英雄必填,自己养成类的英雄不填
        heroCfgId 1: integer #配置表id
    }

    .ComSyncRogueHero {
        news 1: *ComHeroInterim(heroId)                     # 新增英雄
        changes 2: *ComHeroInterim(heroId)                  # 更新英雄
        removes 3: *integer 
    }

    .ComSyncGear2Point {
        news 1: *ComIntInt()                          # 新增
        changes 2: *ComIntInt()                       # 更新
        removes 3: *integer                           # 删除
    }

    .ComRogueEventId {
        eventType 1: integer
        eventId 2: integer
    }

    .ComSyncRogueRoom2EventId {
        news 1: *ComRogueRoom2EventId(roomIndex)
        changes 2: *ComRogueRoom2EventId(roomIndex)
        removes 3: *integer
    }

.ComCompose {
        id 0: integer
        count 1: integer
    }

.ComActFishCacheDepthListItem {  # 每个深度配置的鱼的信息
        id 0: uint32                 # 在 activityFishingRefresh 配置表中的 id
        fishCfgIdList 1: *uint32     # 刷出来的鱼的配置id列表
    }

    .ComActFishCache {               # 待钓的鱼的信息
        pondType 0: uint32           # 钓鱼类型 1=普通钓饵 2=特质钓饵
        depthList 1: *ComActFishCacheDepthListItem(id)

        searchLight 2: boolean       # 使用探照灯
        swimBladder 3: boolean       # 使用感应鱼鳔
        fishHook 4: boolean          # 使用特质鱼钩
        fishDetector 5: boolean      # 使用水下探测器
        fishCfgId 6: uint32          # 使用水下探测器选择的鱼
    }

    .ComFishGear {               # 渔具
        fishGearType 0: uint32   # 渔具类型
        lv 1: uint32
    }

    .ComActFish {              # 活动信息
        actId 0: integer       # 活动id
        round 1: integer       # 轮次
        state 2: integer
        isOver 3: boolean
        groupId 4: integer

        fishGear 5: *ComFishGear(fishGearType)
        fishCache 6: ComActFishCache
        cached 7: boolean         # 是否有钓鱼缓存

        fishCoin 8: uint32        # 钓鱼币
        rankPoint 9: uint32       # 排行榜积分
        fishCommonBait 10: uint32 # 普通鱼饵
        achieveDepth 11: uint32   # 达到的深度
    }

    .ComSyncActFish {
        news 0: *ComActFish(actId)
        changes 1: *ComActFish(actId)
        removes 2: *integer
    }

    .ComActFishBase {                      # 钓鱼活动基本信息
        nextRestoreBaitTime 0: integer     # 下一次恢复鱼饵时间戳（秒）
        lastRestoreBaitTime 1: integer     # 上一次恢复鱼饵时间戳（秒）
    }

.ClientInfo {
    	platform 0: string # 登录设备平台
    	deviceId 1: string # 登录设备id
    	version 2: string # 游戏版本号
    	sysVersion 3: string # 系统版号
    	deviceType 4: string # 设备型号
    	deviceLanguage 5: string # 设备语言
        language 6: string # 游戏语言
        carrier 7: string # 运营商
        gameversion 8: string # 游戏资源(热更)版本号
        channel 9: string # 渠道
        country 10: string # 国家(导量分量器测试时候用)
	}

.ComModifiedTankBase {
        tankLv 0: uint32            # 改装车等级
        upLvTimes 1: uint32         # 升级次数

        nextDayResetTime 2: uint32   # 上次每日重置时间
        dayFreeUpLvTimes 3: uint32   # 已经使用的每日免费
        dayFreeItemCount 4: uint32   # 已领取的每日免费道具数量

        activeSuitId 5: uint32       # 激活的套装ID
        skillIds 6: *uint32          # 已激活的技能ID列表
    }
  
    .ComModifiedTankPart {
        partType 0: uint32      # 部位类型
        tankPartLv 1: uint32    # 部位等级
    }
    
    .ComSyncModifiedTankPart {
        news 0: *ComModifiedTankPart(partType)
        changes 1: *ComModifiedTankPart(partType)
        removes 2: *integer
    }

    .ComModifiedTank4Troop {
        modifiedTankParts 0: *ComModifiedTankPart(partType)   # 改装车部位列表
        tankLv 1: uint32                # 改装车等级
        attrs 2: *ComIntInt()           # 提供的属性
        activeSkillLv 3: uint32         # 激活的技能等级
        activeSkillIds 4: *uint32       # 已激活的技能ID列表
    }

.ComActBoss {
        open 0 : boolean        # 是否解锁
        groupId 1 : integer     # 组Id
        npcId 2 : integer       # boss Id
        barrierId 3 : integer   # 副本Id
        maxDmg 4 : integer      # 最大伤害
        rewards 5 : *ComIntBool()    # 已领取的宝箱
        cnt 6 : integer         # 剩余进入副本的次数
        cntTs 7 : integer       # 剩余进入副本的次数ts
        cntIdx 8 : integer      # 剩余进入副本的次数idx
        endTs 9 : integer       # 进入副本的结束时间
    }

    .ComActBossBox {
        key 0: integer          # 宝箱group id
        value 1: *ComIntBool()  # 宝箱领取状态
    }

    .ComBarrierInfo {
        cntKey 0: integer           # 副本内宝箱钥匙使用数量
        boxes 1 : *ComActBossBox()  # 副本内宝箱开启信息
        doors 2 : *ComIntBool()     # 副本内开启的门
        first 3 : boolean           # 副本是否首次进入 true=首次进入
    }

    .ComActBossBoxRess {
        key 0: integer
        value 1: *ComRes
    }

.ComDailyAttackBossBase {
        daySpecialAwardFlag 0: boolean # 每日特殊奖励领取标记
        lastDayResetTime 1: uint32 # 上次每日重置时间 秒
    }

.ComActivityMonsterSiege { #怪物攻城数据
        actId 0 : integer # 活动id
        round 1 : integer # 轮次
        state 2 : integer # 状态
        param 3 : MonsterSiegeParam # 活动参数
        data  4 : MonsterSiegeData
    }

    .MonsterSiegeParam {
        allianceRankId 1: integer #联盟积分榜
        personRankId 2: integer #个人积分榜
    }

    .ComSiegeMember {
        uid 0: integer #玩家uid
        score 1: integer #玩家个人积分
        failNum 2: integer #失败次数
    }

    .MonsterSiegeData {
        lastDifficulty 0: integer #上次活动选择的难度
        difficulty 1: integer #当前选择的难度
        siegeTime 2: integer #预约开启时间
        highestScore 3: integer #历史最高联盟积分
        score 4: integer #当前联盟积分
        members 5: *ComSiegeMember(uid) #活动参与人员id
        totalRound 6: integer #攻城总轮次
        curRound 7: integer #当前攻城轮次
        attackData 8: ComSiegeAttack #攻城数据
        attackEndTime 9: integer #攻城阶段结束时间
        isOver 10: boolean #攻城是否结束
        unlockDifficulty 11: integer # 已经解锁的最高难度
    }    

    .ComSiegeAttack {
        monsterId 1: integer #怪物id
        attackType 2: integer #怪物攻击目标 1全部联盟成员 2随机抽取联盟成员 3联盟中心 4随机抽取联盟中心
        idList 3: *integer #被攻击目标id
        attackStage 4: integer # 1准备中 2刷新中
        stageEndTime 5: integer # 当前状态结束时间
    }

.ComPrivilegeCard {
        cfgId 0: integer                        # 配置id
        bActive 1: boolean                      # 是否激活状态
        endTime 2: integer                      # 激活结束时间
        lastRewardTime 3: integer               # 上次发送奖励时间（手动领奖、过天自动发奖都会更新本时间）
        continueDay 4:  integer                 # 已经连续领取的天数（根据这个判断奖池）
        activeTime 5: integer                   # 本卡激活时间
        payGiftCount 6 : integer                # 本特权卡已经通过礼包激活次数（根据这个判断下次礼包激活是获得什么奖励）
        unClaimRechargeReward 7: *integer       # 未领取的礼包激活特权卡奖励列表（奖池id列表）
    }

.ComArmyIdAndNum {
        id 0: uint32
        num 1: uint32
    }

    .ComTroopArmy {
        troopId 0: integer              #部队id
        army 1: *ComArmyIdAndNum()      #各兵种数量
    }

    .ComPath {
        x 0: double
        y 1: double
        time 2: double # 路段行军时间
        rate 3: double # 路段/总路程的比例
    }

    .ComPoint {
        x 0: integer
        y 1: integer
    }

    .ComIntBool {
        key 0: integer
        value 1: boolean
    }

    .ComIntInt {
        key 0: integer
        value 1: integer
    }

    .ComUint32Uint32 {
        key 0: integer
        value 1: integer
    }

    .ComIntDouble {
        key 0: integer
        value 1: double
    }

    .ComStringString {
        key 0: string
        value 1: string
    }

    .ComIntString {
        key 0: integer
        value 1: string
    }

    .ComRes {
        type 0: integer
        cfgId 1: integer
        num 2: integer
        isExchange 3: boolean # 是否是兑换获得的资源，比如英雄已经存在，会发给玩家碎片，这个时候isExchange为true
    }

    .ComPlayerBaseInfo {
        uid              0: integer                         # uid 
        headId           1 : integer                        # 头像id
        headFrame        2 : integer                        # 头像框id    
        allianceAbbName  3 : string                         # 联盟简称
        nickName         4 : string                         # 玩家昵称
        posX             5 : integer                        # 玩家位置x
        posY             6 : integer                        # 玩家位置y
    }

    .ComSkillSlot {
        slotId 1: integer                     # 技能槽
        lv 2 : integer                        # 技能槽等级
        skillIds 3 : *integer                 # 技能槽中的技能配置id
        bUnlock 4 : boolean                   # 是否已解锁
    }

    .ComHeroEquip {                             # 从英雄模块给客户端装备信息
        equipId 1: integer                      # id
        itemCfgId 2 : integer                   # itemCfgId
        lv 3: integer                           # 装备等级
        rankLv 4: integer                       # 装备阶数
    }

    .ComExclusiveEquipSkill {
        slotId 1: integer                    # 技能槽id
        skillIds 2: *integer                 # 技能id
    }

    .ComHero {
        heroCfgId 1: integer                    # 配置表id
        lv 2:integer                            # 等级
        skillSlots 3: *ComSkillSlot(slotId)     # 技能槽
        attrs 4: *ComIntInt()                   # 英雄属性信息
        starLv 5 : integer                      # 英雄星级
        power 6: integer                        # 英雄战力
        originalLv 7: integer                   # 原始等级
        lastResetLvTimeSec 8: integer           # 上次重置等级的时间戳
        resonanceLv 9 : integer                 # 共鸣等级
        equips 10: *ComHeroEquip(equipId)       # 装备，注意：其他模块要共用这个定义，不过英雄模块给客户端的信息中，没给这个字段
        isResonance 11: boolean                 # 是否共鸣，注意：其他模块要共用这个定义，不过英雄模块给客户端的信息中，没给这个字段
        honorLv 12: integer                     # 荣誉等级
        exclusiveEquipLv 13: integer            # 专属装备等级
        exclusiveEquipSkills 14: *ComExclusiveEquipSkill(slotId) # 专属装备技能
    }

    .ComArenaHeroEquip {
        equipId 1: integer
        itemCfgId 2: integer
        lv 3: integer           #装备等级
        rankLv 4: integer       #装备阶数
    }

    .ComArenaHero {
        heroCfgId 1: integer                    # 配置表id
        lv 2:integer                            # 等级
        skillSlots 3: *ComSkillSlot(slotId)     # 技能槽
        attrs 4: *ComIntInt()                   # 英雄属性信息
        equips 5: *ComArenaHeroEquip(equipId)   # 英雄装备
        starLv 6 : integer                      # 英雄星级
        power 7: integer                        # 英雄战力
        originalLv 8: integer                   # 原始等级
        lastResetLvTimeSec 9: integer           # 上次重置等级的时间戳
        skillPower 10: integer                  # 技能战力 客户端用
    }
    
    .ComHeroBrief {
        heroCfgId 1: integer                    # 配置表id
        lv 3:integer                            # 等级
        starLv 7 : integer                      # 英雄星级
        power 8: integer                        # 英雄战力
    }

    .ComHeroInterim { #临时的英雄,非养成类,可重复
        heroId 0: integer                       # 英雄ID
        heroCfgId 1: integer                    # 配置表id
        lv 3:integer                            # 等级
        skillSlots 4: *ComSkillSlot(slotId)     # 技能槽
        attrs 5: *ComIntInt()                   # 英雄属性信息
        starLv 7 : integer                      # 英雄星级
        power 8: integer                        # 英雄战力
        equips 9: *ComHeroEquip(equipId)        # 装备
        originalLv 10:integer                   # 原始等级
        isResonance  11:boolean                 # 是否共鸣
    }

    .ComHeroPersonPvp { #赛季个人pvp英雄
        heroCfgId 1: integer                    # 配置表id
        lv 3:integer                            # 等级
        skillSlots 4: *ComSkillSlot(slotId)     # 技能槽
        attrs 5: *ComIntInt()                   # 英雄属性信息
        starLv 7 : integer                      # 英雄星级
        power 8: integer                        # 英雄战力
        equips 9: *ComHeroEquip(equipId)        # 装备
        originalLv 10:integer                   # 原始等级
        isResonance  11:boolean                 # 是否共鸣
        isDisable 12: boolean                   # 是否禁用
        disableTs 13: integer                   # 禁用开始时间戳
    }

    .ComTroopLose {
        troopId 1 : integer                          # 部队id
        truce 2: *ComArmyIdAndNum()                  # 轻伤
        wound 3: *ComArmyIdAndNum()                  # 重伤
        dead  4: *ComArmyIdAndNum()                  # 死亡    
        remain 5: *ComArmyIdAndNum()                 # 生还
        totalHurt 6: integer                         # 总伤害
        allNum 7: integer                            # 总数量
        curLoseNum 8: integer                        # 损失数量
    }

    .ComSkillDmg {
        skillId   2: integer                    # 技能id
        dmg       3: integer                    # 技能击杀数量：技能造成伤害的数量
        heal      4: integer                    # 技能保护数量：技能护盾抵消士兵数+技能治疗士兵数
    }

    .ComHeroDmg {
        heroCfgId 1: integer                    # 英雄配置id
        skillDmg  2: *ComSkillDmg(skillId)      # 技能伤害数据
    }

    #伤害数据
    .ComTroopDmg {
        unitId 1 : integer                            # 方阵id
        armyNum 2 : integer                           # 初始兵量
        remain 3 : integer                            # 生还
