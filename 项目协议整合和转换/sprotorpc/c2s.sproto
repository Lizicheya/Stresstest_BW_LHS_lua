        offOfficialTime 2: integer              # 当前岗位上的玩家离任时间戳（秒）
    }
    .ComSyncOfficialWaitQueue {
        news 0: *ComOfficialWaitQueue(id)
        changes 1: *ComOfficialWaitQueue(id)
        removes 2: *integer
    }

    .ComOfficialApplyListItem {
        uid 0: integer         # 申请的玩家uid
