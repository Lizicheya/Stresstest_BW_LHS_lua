            occupyTime 3: integer  # 占领积分仓库
            killMonster 4: integer # 击杀怪物
            pickScore 5: integer # 拾取积分
            occupyNum 6: integer # 占领积分矿
            isJoin 7: boolean # 玩家是否参与了游戏
            optOutTimes 8: integer #报名了不参与次数
            sceneId 9: integer # 场景id
        }
    }

