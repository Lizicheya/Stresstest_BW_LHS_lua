    }

    .ComTask {
        id 0: integer                   # id(每个玩家的任务id唯一)
        status 1: integer               # 任务状态
        count 2: integer                # 任务当前进度数量
        cfgId 3: integer                # 任务配置ID
        finishTime 4: integer           # 任务完成时间
    }

    .ComAllianceEnemyInfo {
        uid 1: integer #uid
        nickName 2: string #盟主昵称
