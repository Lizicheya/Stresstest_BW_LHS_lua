        isOnline 0:boolean                              #是否在线 true 在线 false 刚登录
        x 1: integer                                    #新城坐标x
        y 2: integer                                    #新城坐标y
        autoMoveType 3: integer                         #自动迁城类型 0被打飞 1 从王城警戒区自动迁走 2 很久不上线被迁走 3=跨服战系统遣返 4 加入联盟自动迁城
    }
    response {
    }
}


