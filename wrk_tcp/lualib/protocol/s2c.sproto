        score 8: integer     # 玩家个人积分
        npcFailCnt 9: integer  # 怪物挑战失败次数
        stat 10 : *ComIntInt() # 玩家杀怪统计 npcId=数量
        helpDot 11: integer    # 小红点>0
        npcPosX 12: integer    # 当前怪物地图对象坐标
        npcPosY 13: integer    # 当前怪物地图对象坐标
