        dmgSkill 5 : integer                          # 造成技能伤害
        dmgTaken 6 : integer                          # 承担伤害
        heroDmg  7 : ComHeroDmg                       # 英雄伤害数据
    }

    #各兵种战斗详情
    .ComTroopArmyDetail {
        armyId 1 : integer                           # 士兵id
