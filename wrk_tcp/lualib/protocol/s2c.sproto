    # 联盟简要信息
    .ComAllianceBrief {
        aid 0: integer                          # 联盟id
        fullName 1: string                      # 联盟全称
        abbName 2: string                       # 联盟简称
        flagId 3: integer                       # 联盟旗帜
        patternId 4: integer                    # 联盟旗帜模板
        colorId 5: integer                      # 标志颜色
